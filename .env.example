# Copy to .env for local development. Never commit real credentials.
#
# None of these are needed to run `qyre` itself (that takes a connection target as a CLI argument);
# they're only for `pnpm test`/`pnpm test:e2e:full` against real Postgres/MySQL/MongoDB databases.
# `docker-compose.yml` (F057) starts all three with these same credentials/ports, matching
# .github/workflows/ci.yml's service containers exactly.

# Optional: a Postgres connection string used by integration tests and the "postgres" E2E project.
# Example: postgres://postgres:postgres@localhost:5432/qyre_test
QYRE_TEST_DATABASE_URL=

# Optional: override the restricted Postgres fixture user used by permission tests. When omitted,
# @qyre/testing derives it from QYRE_TEST_DATABASE_URL with qyre_readonly:qyre_readonly credentials.
QYRE_TEST_READONLY_DATABASE_URL=

# Optional: a MySQL connection string used by integration tests and the "mysql" E2E project.
# Example: mysql://root:root@localhost:3306/qyre_test
QYRE_TEST_MYSQL_URL=

# Optional: a MongoDB connection string used by integration and Playwright E2E tests.
# Example: mongodb://localhost:27017/qyre_test
QYRE_TEST_MONGO_URL=

# Optional: SQLite fixture file path used by the "sqlite" E2E project. Created automatically if
# missing. Example: .local/e2e-fixture.sqlite
QYRE_TEST_SQLITE_PATH=

# Optional: override the default statement/row-fetch timeout (ms) every adapter enforces (F032).
QYRE_STATEMENT_TIMEOUT_MS=

# Optional: override the local server port Qyre listens on (default: 7717).
QYRE_PORT=
