{
  "name": "qyre-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Qyre - a local-first database management UI you can launch from the terminal.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/with-local-env.mjs pnpm test:run",
    "test:run": "turbo run test",
    "test:e2e": "node scripts/with-local-env.mjs pnpm test:e2e:run",
    "test:e2e:run": "pnpm --filter @qyre/web build && playwright test --grep @smoke",
    "test:e2e:full": "node scripts/with-local-env.mjs pnpm test:e2e:full:run",
    "test:e2e:full:run": "pnpm --filter @qyre/web build && playwright test --grep @full",
    "check:features": "node scripts/check-features.mjs",
    "check:handoff": "node scripts/check-handoff.mjs",
    "check:harness": "node scripts/check-harness.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "check:engine-lockstep": "node scripts/check-engine-lockstep.mjs",
    "check:web-structure": "node scripts/check-web-structure.mjs",
    "check:state": "pnpm check:features && pnpm check:handoff && pnpm check:harness && pnpm check:readme && pnpm check:engine-lockstep && pnpm check:web-structure",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:state",
    "check:quiet": "node scripts/with-local-env.mjs pnpm check:quiet:run",
    "check:quiet:run": "pnpm format:check && pnpm lint && turbo run typecheck test build --output-logs=errors-only && pnpm check:state",
    "check:ci": "pnpm check && pnpm test:e2e && pnpm test:e2e:full",
    "verify:pr": "node scripts/verify-pr.mjs",
    "context": "node scripts/context-summary.mjs",
    "features": "node scripts/features-summary.mjs",
    "features:prune": "node scripts/prune-features.mjs",
    "release": "node scripts/publish.mjs",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@qyre/core": "workspace:*",
    "@qyre/driver-contract": "workspace:*",
    "@qyre/postgres": "workspace:*",
    "@qyre/server": "workspace:*",
    "@qyre/testing": "workspace:*",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
