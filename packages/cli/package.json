{
  "name": "@qyre/qyre",
  "version": "0.2.1",
  "type": "module",
  "description": "Launch a local-first database management UI from your terminal.",
  "keywords": [
    "database",
    "postgres",
    "postgresql",
    "sqlite",
    "mysql",
    "mongodb",
    "cli",
    "gui",
    "ide",
    "database-gui",
    "database-client",
    "read-only"
  ],
  "homepage": "https://github.com/ensp1re/qyre#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensp1re/qyre.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/ensp1re/qyre/issues",
  "license": "MIT",
  "bin": {
    "qyre": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@qyre/core": "workspace:*",
    "@qyre/driver-contract": "workspace:*",
    "@qyre/mongodb": "workspace:*",
    "@qyre/mysql": "workspace:*",
    "@qyre/postgres": "workspace:*",
    "@qyre/server": "workspace:*",
    "@qyre/sqlite": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "figlet": "^1.11.0",
    "gradient-string": "^3.0.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@qyre/config": "workspace:*"
  }
}
