{
  "name": "humb",
  "version": "0.0.0",
  "type": "module",
  "description": "Launch a local-first database management UI from your terminal.",
  "keywords": [
    "database",
    "postgres",
    "postgresql",
    "sqlite",
    "cli",
    "gui",
    "ide",
    "database-gui",
    "database-client",
    "read-only"
  ],
  "homepage": "https://github.com/ensp1re/humb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensp1re/humb.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/ensp1re/humb/issues",
  "license": "MIT",
  "bin": {
    "humb": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@humb/core": "workspace:*",
    "@humb/driver-contract": "workspace:*",
    "@humb/postgres": "workspace:*",
    "@humb/server": "workspace:*",
    "@humb/sqlite": "workspace:*",
    "commander": "^12.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@humb/config": "workspace:*"
  }
}
