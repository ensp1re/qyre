{
  "name": "@qyre/core",
  "version": "0.3.0",
  "type": "module",
  "description": "Shared domain types and contracts for Qyre.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./filter-capabilities": {
      "types": "./dist/filter-capabilities.d.ts",
      "import": "./dist/filter-capabilities.js"
    },
    "./mutation-editor-capabilities": {
      "types": "./dist/mutation/editor-capabilities.d.ts",
      "import": "./dist/mutation/editor-capabilities.js"
    },
    "./mutation-editor-values": {
      "types": "./dist/mutation/editor-values.d.ts",
      "import": "./dist/mutation/editor-values.js"
    },
    "./csv-import": {
      "types": "./dist/csv-import.d.ts",
      "import": "./dist/csv-import.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@qyre/config": "workspace:*"
  }
}
