  },
  "dependencies": {
    "@qyre/core": "workspace:*",
    "@qyre/driver-contract": "workspace:*",
    "bson": "^7.3.4",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "@qyre/config": "workspace:*",
    "@qyre/testing": "workspace:*"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
