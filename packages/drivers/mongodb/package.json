{
  "name": "@humbdb/mongodb",
  "version": "0.0.3",
  "type": "module",
  "description": "MongoDB adapter for Humb (basic read-only browsing).",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@humbdb/core": "workspace:*",
    "@humbdb/driver-contract": "workspace:*",
    "mongodb": "^7.4.0"
  },
  "devDependencies": {
    "@humbdb/config": "workspace:*",
    "@humbdb/testing": "workspace:*"
  }
}
