{
  "name": "@humbdb/sqlite",
  "version": "0.0.3",
  "type": "module",
  "description": "SQLite driver for Humb.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
