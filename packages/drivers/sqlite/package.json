  },
  "dependencies": {
    "@humbdb/core": "workspace:*",
    "@humbdb/driver-contract": "workspace:*",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@humbdb/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13"
  }
