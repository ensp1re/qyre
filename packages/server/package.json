{
  "name": "@qyre/server",
  "version": "0.2.0",
  "type": "module",
  "description": "Local HTTP server for Qyre (Fastify).",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/static": "^9.1.3",
    "@qyre/core": "workspace:*",
    "@qyre/driver-contract": "workspace:*",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@qyre/config": "workspace:*"
  }
}
