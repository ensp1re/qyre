{
  "name": "@qyre/testing-conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-engine adapter-conformance suite (F054). Lives in its own package, not @qyre/testing, so importing all four drivers here doesn't create a build cycle with the drivers' own devDependency on @qyre/testing's fixtures.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf .turbo"
  },
  "devDependencies": {
    "@qyre/config": "workspace:*",
    "@qyre/core": "workspace:*",
    "@qyre/driver-contract": "workspace:*",
    "@qyre/mongodb": "workspace:*",
    "@qyre/mysql": "workspace:*",
    "@qyre/postgres": "workspace:*",
    "@qyre/sqlite": "workspace:*",
    "@qyre/testing": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.11.10",
    "better-sqlite3": "^12.11.1",
    "mongodb": "^7.4.0",
    "mysql2": "^3.22.5",
    "pg": "^8.13.1"
  }
}
